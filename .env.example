# Copy to .env and fill in. Never commit .env.

# HoYoLAB cookies (from a logged-in browser on hoyolab.com). These work like a login.
HOYOLAB_LTUID_V2=
HOYOLAB_LTOKEN_V2=
HOYOLAB_LTMID_V2=
GENSHIN_UID=

# Notion integration token and database IDs (init-notion fills the IDs in)
NOTION_TOKEN=
NOTION_DB_CHARACTERS=
NOTION_DB_MATERIALS=
NOTION_DB_NEEDS=
NOTION_DB_DAILY=

# Time model (see docs/DESIGN.md section 7)
LOCAL_TZ=America/New_York
SERVER_UTC_OFFSET=8
RESET_HOUR=4
SPECIALTY_RESPAWN_HOURS=48
