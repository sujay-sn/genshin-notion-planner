# Copy to .env and fill in. Never commit .env.

# HoYoLAB cookies (from a logged-in browser on hoyolab.com). These work like a login.
HOYOLAB_LTUID_V2=
HOYOLAB_LTOKEN_V2=
HOYOLAB_LTMID_V2=
GENSHIN_UID=

# Notion integration token, and the page the databases go under. Connect the
# integration to that page first. init-notion fills in the data source IDs.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DS_CHARACTERS=
NOTION_DS_MATERIALS=
NOTION_DS_NEEDS=
NOTION_DS_DAILY=

# Time model (see docs/DESIGN.md section 7)
LOCAL_TZ=America/New_York
SERVER_UTC_OFFSET=8
RESET_HOUR=4
SPECIALTY_RESPAWN_HOURS=48
